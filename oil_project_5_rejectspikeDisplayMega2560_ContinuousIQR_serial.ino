// ==========================================
// ฟังก์ชันย่อยสำหรับวาด Bitmap (เวอร์ชันเสถียรและเร็วที่สุดสำหรับ Mega2560)
// ==========================================
void drawScaledBitmap(int16_t x, int16_t y, const uint8_t *bitmap, int16_t w, int16_t h, uint16_t color, uint16_t bg, uint8_t scale) {
  int16_t scaledW = w * scale;
  
  // ใช้ Static Buffer (จองแรมตายตัว 512 bytes) ปลอดภัยสุดๆ สำหรับ Mega2560 
  uint16_t lineBuffer[256]; 
  
  int16_t byteWidth = (w + 7) / 8;
  uint8_t byte = 0;
  
  for (int16_t j = 0; j < h; j++) {
    for (int16_t i = 0; i < w; i++) {
      if (i & 7) {
        byte <<= 1;
      } else {
        // ใช้ (uint32_t) ครอบ offset ป้องกัน pointer ทะลุ (Overflow)
        uint32_t offset = (uint32_t)j * byteWidth + (i / 8);
        byte = pgm_read_byte(bitmap + offset);
      }
      
      uint16_t pixelColor = (byte & 0x80) ? color : bg;
      
      for (uint8_t s = 0; s < scale; s++) {
        lineBuffer[i * scale + s] = pixelColor;
      }
    }
    
    // โยนข้อมูลให้จอแสดงผลทีละบรรทัดแนวนอน (เร็วและป้องกันจอภาพกระพริบ)
    for (uint8_t s = 0; s < scale; s++) {
      tft.drawRGBBitmap(x, y + (j * scale) + s, lineBuffer, scaledW, 1);
    }
  }
}

// ==========================================
// Setup
// ==========================================
void setup() {
  Serial.begin(9600);

  pinMode(switchPinK1, INPUT_PULLUP);
  pinMode(switchPinK2, INPUT_PULLUP);
  pinMode(switchPinK3, INPUT_PULLUP);

  // เริ่มต้นจอ TFT ST7789
  tft.init(240, 320); 
  tft.invertDisplay(false); 
  tft.setRotation(rotation);

  // เริ่มต้น ADS1115
  if(!ads.begin(0x48)) {
    Serial.println("ERROR,ADS1115_INIT");
    while(1);
  }

  // Start the new clean Serial protocol immediately after ADS1115 is ready.
  outputRawSerialSample("DATA");

  // แอนิเมชันเปิดเครื่อง โชว์ 2 โลโก้สลับกัน
  tft.fillScreen(ST77XX_BLACK);
  drawScaledBitmap(32, 56, epd_bitmap_nrt_logo_top_copy, 128, 64, tft.color565(0, 255, 0), ST77XX_BLACK, 2);
  waitWithSerialOutput(1500);
  tft.fillScreen(ST77XX_BLACK);
  drawScaledBitmap(32, 56, epd_bitmap_LOGO_RMUTR_, 128, 64, tft.color565(255, 0, 0), ST77XX_BLACK, 2);
  waitWithSerialOutput(1500);
  
  // ค้างไว้ที่โลโก้ NRT พร้อมรอคำสั่ง
  showLogo();
}

// ==========================================
// Loop
// ==========================================
void loop() {
  switchK1 = digitalRead(switchPinK1);
  switchK2 = digitalRead(switchPinK2);
  switchK3 = digitalRead(switchPinK3);
  serviceRawSerialOutput();

  // === จัดการปุ่ม K1 (สลับโหมด Continuous / Single / Clear Screen) ===
  if (switchK1 == LOW && lastswitchK1 == HIGH) { 
    k1PressTime = millis();
    k1ModeBeforePress = isContinuousMode;
    k1LongPressHandled = false;
  }
  
  if (switchK1 == LOW && lastswitchK1 == LOW) { 
    // กำลังกดค้างอยู่ เช็คว่าถึง 3 วินาที (3000ms) หรือยัง
    if (!k1LongPressHandled && millis() - k1PressTime >= K1_LONG_PRESS_MS) {
      k1LongPressHandled = true;
      isContinuousMode = !k1ModeBeforePress; // Toggle from the mode before K1 was pressed.
      
      if (isContinuousMode) {
        // แสดง Splash Screen ก่อนเข้าโหมด Continuous
        tft.fillScreen(ST77XX_BLACK);
        tft.setTextColor(ST77XX_YELLOW);
        tft.setTextSize(4);
        const char* msg1 = "CONTINUOUS";
        const char* msg2 = "MODE";
        tft.setCursor((320 - strlen(msg1)*24)/2, 90); tft.print(msg1);
        tft.setCursor((320 - strlen(msg2)*24)/2, 130); tft.print(msg2);
        
        waitWithSerialOutput(2000);
        drawContinuousLayout();

        lastContinuousUpdate = millis();
      } else {
        // แสดง Splash Screen ก่อนกลับเข้าโหมด Single
        tft.fillScreen(ST77XX_BLACK);
        tft.setTextColor(ST77XX_GREEN);
        tft.setTextSize(4);
        const char* msg1 = "SINGLE";
        const char* msg2 = "MODE";
        tft.setCursor((320 - strlen(msg1)*24)/2, 90); tft.print(msg1);
        tft.setCursor((320 - strlen(msg2)*24)/2, 130); tft.print(msg2);
        
        waitWithSerialOutput(2000);
        showLogo();
      }
      
      // รอจนกว่าจะปล่อยปุ่ม เพื่อป้องกันการสลับโหมดซ้ำๆ ทันที
      while(digitalRead(switchPinK1) == LOW) {
        serviceRawSerialOutput();
        delay(10);
      }
      switchK1 = HIGH; // รีเซ็ตสถานะปุ่ม
      lastswitchK1 = HIGH; // <--- เพิ่มบรรทัดนี้ เพื่อบอกระบบว่าเคลียร์การกดปุ่มแล้ว จะได้ไม่ไปทริกเกอร์กดสั้นซ้ำ!
      k1PressTime = millis();
    }
  }

  if (switchK1 == HIGH && lastswitchK1 == LOW) {
    // A short K1 press clears only in Single mode. A long press has already
    // been handled above and must never clear calibration data.
    if (!k1LongPressHandled && !k1ModeBeforePress) {
      clearAllMeasurementData();
      showLogo();
    }
  }

  lastswitchK1 = switchK1;

  // === จัดการปุ่ม K2 และ K3 (ให้ทำงานเฉพาะโหมด Single เท่านั้น) ===
  if (!isContinuousMode && switchK1 == HIGH) {
    // K3 → Calibrate
    if(switchK3 != lastswitchK3 && switchK3 == LOW) {
      outputRawSerialSample("K3_PRESS");
      calibrateReference();
    }
    lastswitchK3 = switchK3;

    // K2 → Measure
    if(switchK2 != lastswitchK2 && switchK2 == LOW) {
      takeMeasurement();
    }
    lastswitchK2 = switchK2;

  }

  // === อัปเดตการแสดงผลในโหมด Continuous (ทุก 50ms) ===
  if (isContinuousMode) {
    if (millis() - lastContinuousUpdate >= 50) {
      lastContinuousUpdate = millis();
      
      // อ่านค่าดิบ
      int16_t adc0 = ads.readADC_SingleEnded(0);
      int16_t adc1 = ads.readADC_SingleEnded(1);
      float rawVPHS = adc0 * 0.1875 / 1000.0;
      float rawVMAG = adc1 * 0.1875 / 1000.0;

      // เซ็ตฟอนต์และการวาดทับสีพื้นหลัง (ลบเลขเก่าอัตโนมัติ ไม่จอกะพริบ)
      tft.setTextSize(4);
      tft.setTextColor(ST77XX_WHITE, ST77XX_BLACK); 

      // แปลงเป็น String แบบระบุความกว้าง (7 ตัวอักษร) เพื่อให้ถมสีดำทับของเดิมได้สนิท
      char vphsStr[10];
      dtostrf(rawVPHS, 7, 3, vphsStr); 
      tft.setCursor(15, 80);
      tft.print(vphsStr);

      char vmagStr[10];
      dtostrf(rawVMAG, 7, 3, vmagStr);
      tft.setCursor(15, 175);
      tft.print(vmagStr);

    }
  }

  delay(10); // หน่วงเวลาเล็กน้อยเพื่อ Debounce ปุ่ม
}

// ==========================================
// ฟังก์ชันการทำงานหลัก
// ==========================================
void showLogo() {
  tft.fillScreen(ST77XX_BLACK);
  // ขนาดโลโก้ 128x64 คูณ 2 เท่า = 256x128 จัดให้อยู่กึ่งกลางจอ (320x240)
  drawScaledBitmap(32, 56, epd_bitmap_nrt_logo_top_copy, 128, 64, tft.color565(0, 255, 0), ST77XX_BLACK, 2);
}

void clearAllMeasurementData() {
  isCalibrated = false;
  ReferenceVPHS = 0.0;
  ReferenceVMAG = 0.0;
  MeasurementVPHS = 0.0;
  MeasurementVMAG = 0.0;

  for (int i = 0; i < SAMPLE_COUNT; i++) {
    VPHSValue[i] = 0.0;
    VMAGValue[i] = 0.0;
  }
}

void outputRawSerialSample(const char* recordType) {
  int16_t adc0 = ads.readADC_SingleEnded(0);
  int16_t adc1 = ads.readADC_SingleEnded(1);
  float rawVPHS = adc0 * 0.1875 / 1000.0;
  float rawVMAG = adc1 * 0.1875 / 1000.0;

  Serial.print(recordType);
  Serial.print(',');
  Serial.print(millis());
  Serial.print(',');
  Serial.print(rawVPHS, 3);
  Serial.print(',');
  Serial.println(rawVMAG, 3);
  lastRawSerialOutput = millis();
}

void outputCalculatedCalibrationStamp() {
  Serial.print("K3_CAL,");
  Serial.print(millis());
  Serial.print(',');
  Serial.print(ReferenceVPHS, 3);
  Serial.print(',');
  Serial.println(ReferenceVMAG, 3);
}

void outputCollectedSample(const char* recordType, int sampleNumber, float vphs, float vmag) {
  Serial.print(recordType);
  Serial.print(',');
  Serial.print(millis());
  Serial.print(',');
  Serial.print(sampleNumber);
  Serial.print(',');
  Serial.print(vphs, 3);
  Serial.print(',');
  Serial.println(vmag, 3);
}

void serviceRawSerialOutput() {
  if (millis() - lastRawSerialOutput >= SERIAL_OUTPUT_INTERVAL_MS) {
    outputRawSerialSample("DATA");
  }
}

void waitWithSerialOutput(unsigned long durationMs) {
  unsigned long waitStarted = millis();
  while (millis() - waitStarted < durationMs) {
    serviceRawSerialOutput();
    delay(10);
  }
}

bool abortIfK1Pressed() {
  if (digitalRead(switchPinK1) != LOW) {
    return false;
  }

  // Abort the current K2/K3 operation immediately, then classify this K1
  // action as a short press or a 3-second hold before changing stored data.
  unsigned long blockingPressStarted = millis();
  while (digitalRead(switchPinK1) == LOW &&
         millis() - blockingPressStarted < K1_LONG_PRESS_MS) {
    delay(10);
  }

  if (digitalRead(switchPinK1) == LOW) {
    // Long K1 hold from Single mode: enter Continuous and preserve Cal/Mea.
    isContinuousMode = true;
    tft.fillScreen(ST77XX_BLACK);
    tft.setTextColor(ST77XX_YELLOW);
    tft.setTextSize(4);
    const char* msg1 = "CONTINUOUS";
    const char* msg2 = "MODE";
    tft.setCursor((320 - strlen(msg1) * 24) / 2, 90);
    tft.print(msg1);
    tft.setCursor((320 - strlen(msg2) * 24) / 2, 130);
    tft.print(msg2);
    waitWithSerialOutput(2000);
    drawContinuousLayout();

    lastContinuousUpdate = millis();

    while (digitalRead(switchPinK1) == LOW) {
      serviceRawSerialOutput();
      delay(10);
    }
  } else {
    // Short K1 press from Single mode: clear all stored measurement data.
    clearAllMeasurementData();
    showLogo();
  }

  switchK1 = HIGH;
  lastswitchK1 = HIGH;
  lastswitchK2 = digitalRead(switchPinK2);
  lastswitchK3 = digitalRead(switchPinK3);
  k1ModeBeforePress = isContinuousMode;
  k1LongPressHandled = true;
  k1PressTime = millis();
  return true;
}

bool waitWithK1Priority(unsigned long durationMs) {
  unsigned long waitStarted = millis();
  while (millis() - waitStarted < durationMs) {
    serviceRawSerialOutput();
    if (abortIfK1Pressed()) {
      return false;
    }
    delay(10);
  }
  return true;
}

// ฟังก์ชันวาดหน้า Layout เปล่าๆ สำหรับโหมด Continuous
void drawContinuousLayout() {
  tft.fillScreen(ST77XX_BLACK);
  
  // หัวข้อกึ่งกลาง
  tft.setTextSize(2);
  tft.setTextColor(ST77XX_WHITE);
  const char* title = "--- CONTINUOUS ---";
  int titleX = (320 - (strlen(title) * 12)) / 2;
  tft.setCursor(titleX, 10);
  tft.print(title);

  int leftMargin = 15; 

  // หัวข้อ VPHS
  tft.setTextSize(3);
  tft.setTextColor(ST77XX_YELLOW);
  tft.setCursor(leftMargin, 45);
  tft.print("RAW VPHS");

  // หัวข้อ VMAG
  tft.setTextColor(ST77XX_YELLOW);
  tft.setCursor(leftMargin, 140);
  tft.print("RAW VMAG");
}

// ฟังก์ชันจัดการข้อมูล (กรอง Outlier ด้วย IQR, หา Mean และ SD)
void processDataWithIQR(float data[], int size, float &outMean, float &outSD, int &outValidCount) {
  // 1. สร้าง Array สำรองเพื่อเรียงลำดับข้อมูล
  float sortedData[SAMPLE_COUNT];
  for (int i = 0; i < size; i++) {
    sortedData[i] = data[i];
  }

  // 2. เรียงลำดับข้อมูลจากน้อยไปมาก (ใช้ Bubble Sort สำหรับข้อมูลจำนวนน้อย)
  for (int i = 0; i < size - 1; i++) {
    for (int j = 0; j < size - i - 1; j++) {
      if (sortedData[j] > sortedData[j + 1]) {
        float temp = sortedData[j];
        sortedData[j] = sortedData[j + 1];
        sortedData[j + 1] = temp;
      }
    }
  }

  // 3. หา Q1, Q3 และ IQR
  float q1 = sortedData[size / 4];
  float q3 = sortedData[(size * 3) / 4];
  float iqr = q3 - q1;

  float lowerBound = q1 - (1.5 * iqr);
  float upperBound = q3 + (1.5 * iqr);

  // 4. กรอง Outlier และหาค่า Mean ของชุดข้อมูลที่สะอาดแล้ว
  float sum = 0.0;
  int validCount = 0;
  for (int i = 0; i < size; i++) {
    if (data[i] >= lowerBound && data[i] <= upperBound) {
      sum += data[i];
      validCount++;
    }
  }

  if (validCount > 0) {
    outMean = sum / validCount;
  } else {
    outMean = 0.0; // ป้องกันการหาร 0
  }

  // 5. หาค่า SD จากชุดข้อมูลที่กรองแล้ว
  float sumDev = 0.0;
  if (validCount > 0) {
    for (int i = 0; i < size; i++) {
      if (data[i] >= lowerBound && data[i] <= upperBound) {
        sumDev += pow(data[i] - outMean, 2);
      }
    }
    outSD = sqrt(sumDev / validCount);
  } else {
    outSD = 9999.0; // หากข้อมูลโดนตัดหมด บังคับให้ SD สูงเพื่อให้ติด Error
  }
  
  outValidCount = validCount;
}

void calibrateReference() {
  if (!showSaturationCountdown("K3", ST77XX_YELLOW)) {
    return;
  }
  showAnimation("Calibrating..."); 

  // Collect saturated samples at the configured interval.
  for(int i=0;i<SAMPLE_COUNT;i++){
    if (!waitWithK1Priority(SAMPLE_INTERVAL_MS)) {
      return;
    }
    int16_t adc0 = ads.readADC_SingleEnded(0);
    int16_t adc1 = ads.readADC_SingleEnded(1);
    float v0 = adc0*0.1875/1000;
    float v1 = adc1*0.1875/1000;
    VPHSValue[i] = v0;
    VMAGValue[i] = v1;
    outputCollectedSample("K3_SAMPLE", i + 1, v0, v1);

    updateSamplingProgress(i + 1, ST77XX_YELLOW);
  }

  float sdVPHS, sdVMAG;
  int validVPHS, validVMAG;
  
  // 2-6. กรอง IQR และคำนวณสถิติ
  processDataWithIQR(VPHSValue, SAMPLE_COUNT, ReferenceVPHS, sdVPHS, validVPHS);
  processDataWithIQR(VMAGValue, SAMPLE_COUNT, ReferenceVMAG, sdVMAG, validVMAG);

  if (sdVPHS >= (SD_THRESHOLD_VPHS - 0.00001) || sdVMAG >= (SD_THRESHOLD_VMAG - 0.00001)) {
    isCalibrated = false; 
    showErrorScreen("CALIBRATE", sdVPHS, sdVMAG);

  } else {
    isCalibrated = true; 
    showMeasurementResult("--- CALIBRATION ---", "Cal VPHS", ReferenceVPHS, sdVPHS, "Cal VMAG", ReferenceVMAG, sdVMAG, tft.color565(255, 255, 0));
    outputCalculatedCalibrationStamp();
  }
}

void takeMeasurement() {
  if (!isCalibrated) {
    showNotCalibratedScreen(); 
    return; 
  }

  if (!showSaturationCountdown("K2", ST77XX_GREEN)) {
    return;
  }
  showAnimation("Measuring..."); 

  // Collect saturated samples at the configured interval.
  for(int i=0;i<SAMPLE_COUNT;i++){
    if (!waitWithK1Priority(SAMPLE_INTERVAL_MS)) {
      return;
    }
    int16_t adc0 = ads.readADC_SingleEnded(0);
    int16_t adc1 = ads.readADC_SingleEnded(1);
    float v0 = adc0*0.1875/1000;
    float v1 = adc1*0.1875/1000;
    VPHSValue[i] = v0;
    VMAGValue[i] = v1;

    updateSamplingProgress(i + 1, ST77XX_GREEN);
  }

  float sdVPHS, sdVMAG;
  int validVPHS, validVMAG;
  
  // 2-6. กรอง IQR และคำนวณสถิติ
  processDataWithIQR(VPHSValue, SAMPLE_COUNT, MeasurementVPHS, sdVPHS, validVPHS);
  processDataWithIQR(VMAGValue, SAMPLE_COUNT, MeasurementVMAG, sdVMAG, validVMAG);

  float RealVPHS = ReferenceVPHS - MeasurementVPHS;
  float RealVMAG = ReferenceVMAG - MeasurementVMAG;

  if (sdVPHS >= (SD_THRESHOLD_VPHS - 0.00001) || sdVMAG >= (SD_THRESHOLD_VMAG - 0.00001)) {
    showErrorScreen("MEASURE", sdVPHS, sdVMAG);
  } else {
    showMeasurementResult("--- MEASUREMENT ---", "Mea VPHS", RealVPHS, sdVPHS, "Mea VMAG", RealVMAG, sdVMAG, tft.color565(0, 255, 0));
  }
}

