void showErrorScreen(const char* action, float sd1, float sd2) {
  tft.fillScreen(ST77XX_BLACK);
  
  tft.setTextSize(3);
  tft.setTextColor(ST77XX_RED);
  const char* title = "HIGH SD ERROR!";
  int titleX = (320 - (strlen(title) * 18)) / 2;
  tft.setCursor(titleX, 20);
  tft.print(title);

  char sd1Str[10];
  dtostrf(sd1, 6, 4, sd1Str);
  char textVPHS[30];
  sprintf(textVPHS, "SD VPHS: %s", sd1Str);
  
  tft.setTextSize(3);
  tft.setTextColor(ST77XX_CYAN);
  int vphsX = (320 - (strlen(textVPHS) * 18)) / 2;
  tft.setCursor(vphsX, 75);
  tft.print(textVPHS);

  char sd2Str[10];
  dtostrf(sd2, 6, 4, sd2Str);
  char textVMAG[30];
  sprintf(textVMAG, "SD VMAG: %s", sd2Str);
  
  int vmagX = (320 - (strlen(textVMAG) * 18)) / 2;
  tft.setCursor(vmagX, 125);
  tft.print(textVMAG);

  char textRetry[30];
  sprintf(textRetry, "RETRY %s", action);
  tft.setTextColor(ST77XX_YELLOW);
  int retryX = (320 - (strlen(textRetry) * 18)) / 2;
  tft.setCursor(retryX, 190);
  tft.print(textRetry);
}

